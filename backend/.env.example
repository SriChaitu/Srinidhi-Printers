# ============================================================
# Srinidhi Printers — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# Django
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
DB_NAME=printpress_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Owner email(s) — comma-separated list of emails that get auto-promoted to owner
OWNER_EMAILS=owner@example.com

# WhatsApp — phone number shown on the storefront for placing orders
WHATSAPP_PHONE=

# Firebase — absolute path to the service account JSON file
FIREBASE_CREDENTIALS_PATH=

# CORS — comma-separated list of allowed origins (frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173
